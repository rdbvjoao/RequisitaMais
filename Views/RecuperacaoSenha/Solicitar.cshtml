@model SolicitarRecuperacaoViewModel
@{ ViewData["Title"] = "Recuperar senha"; }
<div class="auth-page mx-auto"><div class="card auth-card">
    <partial name="_Logo" />
    <div class="auth-content">
        <div class="auth-header"><p class="eyebrow mb-2">Recupere seu acesso</p><h1>Esqueci minha senha</h1><p class="text-muted mb-0">Informe seu e-mail para receber um código de recuperação.</p></div>
        <form asp-action="Solicitar" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" aria-describedby="EmailErro" /><span asp-validation-for="Email" id="EmailErro" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary w-100">Enviar código</button>
        </form>
        <p class="auth-switch"><a asp-controller="Conta" asp-action="Login">Voltar ao login</a></p>
    </div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
