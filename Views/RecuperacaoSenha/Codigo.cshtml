@model ValidarCodigoViewModel
@{ ViewData["Title"] = "Validar código"; }
<div class="auth-page mx-auto"><div class="card auth-card">
    <partial name="_Logo" />
    <div class="auth-content">
        <div class="auth-header"><p class="eyebrow mb-2">Recupere seu acesso</p><h1>Confira seu e-mail</h1><p class="text-muted mb-0">@RequisitaPlus.Web.Services.RecuperacaoSenhaService.MensagemSolicitacao</p></div>
        <p id="CodigoAjuda">O código e a autorização para trocar a senha expiram 5 minutos após a solicitação. Continue neste navegador.</p>
        <form asp-action="Codigo" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-4"><label asp-for="Codigo" class="form-label"></label><input asp-for="Codigo" type="text" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" aria-describedby="CodigoAjuda CodigoErro" /><span asp-validation-for="Codigo" id="CodigoErro" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary w-100">Validar código</button>
        </form>
        <p class="auth-switch"><a asp-action="Solicitar">Solicitar novo código</a></p>
        <p class="auth-switch"><a asp-controller="Conta" asp-action="Login">Voltar ao login</a></p>
    </div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
