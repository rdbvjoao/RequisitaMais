@model LoginViewModel
@{ ViewData["Title"] = "Entrar"; }
<div class="auth-page mx-auto">
    <div class="card auth-card">
        <div class="auth-logo-area"><img class="auth-logo" src="~/images/logo-requisita.png" asp-append-version="true" alt="Requisita+" width="2159" height="728" /></div>
        <div class="auth-content">
        <div class="auth-header"><p class="eyebrow mb-2">Seu espaço de trabalho</p><h1>Entrar</h1><p class="text-muted mb-0">Acesse sua conta para acompanhar e revisar seus requisitos.</p></div>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input asp-for="ReturnUrl" type="hidden" />
            <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="username" aria-describedby="EmailErro" /><span asp-validation-for="Email" id="EmailErro" class="text-danger"></span></div>
            <div class="mb-4"><label asp-for="Senha" class="form-label"></label><div class="password-field">
                    <input asp-for="Senha" type="password" class="form-control" autocomplete="current-password" aria-describedby="SenhaErro" />
                    <partial name="_PasswordToggle" model='@("Senha")' />
                </div><span asp-validation-for="Senha" id="SenhaErro" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary w-100">Entrar</button>
        </form>
        <p class="auth-switch"><a asp-controller="RecuperacaoSenha" asp-action="Solicitar">Esqueci minha senha</a></p>
        <p class="auth-switch">Ainda não tem conta? <a asp-action="Cadastro" asp-route-returnUrl="@Model.ReturnUrl">Criar conta</a></p>
        </div>
    </div>
    <p class="auth-help"><a asp-controller="Home" asp-action="Ajuda">Precisa de ajuda para começar?</a></p>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
