@model ErrorViewModel
@{ ViewData["Title"] = "Não foi possível concluir"; }
<div class="card p-4"><h1 class="h3">Não foi possível concluir a solicitação</h1><p>Tente novamente em alguns instantes. Se o problema continuar, verifique se o banco da aplicação foi criado e está disponível para gravação.</p>
@if (Model.ShowRequestId) { <p class="text-muted small">Código da solicitação: @Model.RequestId</p> }
<div><a asp-controller="Requisitos" asp-action="Index" class="btn btn-primary">Voltar aos requisitos</a></div></div>
