@model AnaliseRequisitoViewModel
@{
    ViewData["Title"] = "Análise com IA";
    var cultura = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var erro = Model.Erro ?? Model.ErroDescricao;
}
<div class="form-card analysis-page mx-auto">
    <a asp-action="Details" asp-route-id="@Model.Requisito.Id" class="back-link">← Voltar ao requisito</a>
    <h1 class="mt-3">Análise com IA</h1>
    <p class="text-muted">As sugestões podem conter falhas e precisam de revisão humana. Elas não são aplicadas automaticamente à descrição do requisito. Após uma análise concluída e salva com sucesso, o status passa para Em análise, inclusive quando não há sugestões ou o requisito estava Revisado. Em caso de falha, o status anterior é preservado.</p>
    <p class="text-muted">Ao avaliar a última sugestão pendente da análise mais recente, o requisito passa automaticamente para Revisado. Aceitar, Ajustar e Descartar contam como avaliações concluídas. Sem sugestões, marque Revisado pela edição. Esse status representa a conclusão da revisão humana e não garante a qualidade absoluta do requisito.</p>
    <div class="card p-4 mb-4">
        <partial name="_Details" model="Model.Requisito" />
        <p id="contador-descricao" class="mb-0 @(Model.CaracteresDescricao > Model.LimiteCaracteresDescricao ? "text-danger fw-semibold" : "text-muted")">
            @Model.CaracteresDescricao.ToString("N0", cultura) / @Model.LimiteCaracteresDescricao.ToString("N0", cultura) caracteres
            <span class="d-block small">Contagem da descrição salva. O limite se aplica somente à análise com IA.</span>
        </p>
    </div>
    @if (erro is not null)
    {
        <div id="erro-analise" class="alert alert-warning" role="alert">@erro</div>
    }
    else if (Model.Resultado is not null)
    {
        <partial name="_ResultadoAnalise" model="Model.Resultado" />
    }
    <div class="action-bar">
        <a asp-action="Details" asp-route-id="@Model.Requisito.Id" class="btn btn-primary">Voltar ao requisito</a>
        <a asp-action="Historico" asp-route-id="@Model.Requisito.Id" class="btn btn-outline-secondary">Histórico e revisão de sugestões</a>
        <a asp-action="Edit" asp-route-id="@Model.Requisito.Id" class="btn btn-outline-secondary">Editar requisito</a>
        <form asp-action="Analisar" asp-route-id="@Model.Requisito.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-primary" disabled="@(!Model.PodeAnalisar)" aria-describedby="contador-descricao @(erro is not null ? "erro-analise" : "")">Solicitar análise com IA</button>
        </form>
    </div>
</div>
