@model Requisito
@{ ViewData["Title"] = "Editar requisito"; }
<div class="form-card mx-auto">
    <a asp-action="Index" class="back-link">← Voltar aos requisitos</a>
    <h1 class="mt-3">Editar requisito</h1><p class="text-muted">Atualize as informações e acompanhe a evolução do requisito.</p>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card p-4 mt-4"><partial name="_Form" model="Model" /></form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
