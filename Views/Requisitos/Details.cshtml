@model Requisito
@{ ViewData["Title"] = "Detalhes do requisito"; }
<div class="form-card mx-auto">
    <a asp-action="Index" class="back-link">← Voltar aos requisitos</a>
    <h1 class="mt-3 mb-4">Detalhes do requisito</h1>
    <div class="card p-4"><partial name="_Details" model="Model" /><div class="action-bar"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar requisito</a><partial name="_Analisar" model="Model" /><a asp-action="Historico" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Histórico de análises</a><a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Excluir</a></div><p class="text-muted small mt-3 mb-0">A análise com IA usa os dados salvos e pode levar alguns instantes. Aguarde a conclusão e revise as sugestões apresentadas.</p></div>
</div>
