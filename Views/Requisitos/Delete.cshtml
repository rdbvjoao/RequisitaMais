@model Requisito
@{ ViewData["Title"] = "Excluir requisito"; }
<div class="form-card mx-auto">
    <a asp-action="Index" class="back-link">← Voltar aos requisitos</a>
    <h1 class="mt-3 mb-4">Excluir requisito</h1>
    <div class="alert alert-warning">Deseja excluir este requisito? Esta ação não poderá ser desfeita.</div>
    <div class="card p-4"><partial name="_Details" model="Model" /><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><input asp-for="VersaoConcorrencia" type="hidden" /><div asp-validation-summary="ModelOnly" role="alert"></div><button class="btn btn-danger" type="submit">Confirmar exclusão</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form></div>
</div>
