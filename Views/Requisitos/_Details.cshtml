@model Requisito
<h2 class="h4 requirement-title mb-4">@Model.Titulo</h2>
<dl class="row detail-meta">
    <dt class="col-sm-3 mb-2">Tipo</dt><dd class="col-sm-9">@Html.DisplayFor(m => m.Tipo)</dd>
    <dt class="col-sm-3 mb-2">Status</dt><dd class="col-sm-9"><span class="badge status-@((int?)Model.Status)">@Html.DisplayFor(m => m.Status)</span></dd>
    <dt class="col-sm-3 mb-2">Data de criação</dt><dd class="col-sm-9">@Model.DataCriacao.ToString("dd/MM/yyyy 'às' HH:mm")</dd>
</dl>
<h3 class="h6">Descrição</h3><p class="description mb-4">@Model.Descricao</p>
