@model Requisito
@{ ViewData["Title"] = "Novo requisito"; }
<div class="form-card mx-auto">
    <a asp-action="Index" class="back-link">← Voltar aos requisitos</a>
    <h1 class="mt-3">Novo requisito</h1><p class="text-muted">Registre o que o software precisa atender.</p>
    <form asp-action="Create" method="post" class="card p-4 mt-4"><partial name="_Form" model="Model" /></form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
